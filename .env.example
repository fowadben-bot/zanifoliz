# Copier ce fichier en .env sur le serveur OVH. Ne jamais committer .env.
NODE_ENV=production
PUBLIC_ORIGIN=https://votre-domaine.fr

POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_ADMIN_PASSWORD
APP_DB_PASSWORD=CHANGE_ME_LONG_RANDOM_APP_PASSWORD
DB_HOST=db
DB_PORT=5432
DB_NAME=zanifol
DB_USER=zanifol_app
DB_PASSWORD=CHANGE_ME_LONG_RANDOM_APP_PASSWORD
DB_POOL_MAX=10

SESSION_PEPPER=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES
PIN_PEPPER=CHANGE_ME_DIFFERENT_RANDOM_SECRET

# IA - optionnel tant que ZaniChat réel n'est pas activé
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Email transactionnel - obligatoire en production pour les inscriptions parents
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@votre-domaine.fr
